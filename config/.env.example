APP_NAME=JobPatra AI
ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG_ATS_PIPELINE=false

# Secrets — REQUIRED (no defaults, app will not start without these)
INTERNAL_API_KEY=your_internal_api_key
INTERNAL_SERVICE_TOKEN=your_internal_service_token

# LLM Provider API Keys (Google Gemini is the default)
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional — override LLM sampling settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# LangSmith Observability (Phase 10.2)
# Set LANGSMITH_TRACING_ENABLED=true and provide an API key to enable tracing.
# Safe to leave all blank — tracing is disabled by default.
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=jobpatra-ai
